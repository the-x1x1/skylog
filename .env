# Public build-time settings. Safe to commit: nothing here is secret.
#
# PUBLIC_APP_NAME is the product's display name. It is a working name — change it
# here and rebuild. Nothing else in the codebase hard-codes the name, and local
# data (IndexedDB) is stored under a neutral database name, so renaming never
# loses a user's journal.
PUBLIC_APP_NAME=Skylog

# Secrets (API keys for the optional summarizer) belong in .env.local, which is
# git-ignored and never bundled into browser code. See .env.example.
