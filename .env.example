# Copy to .env.local and fill in ONLY if you want AI summaries through the local
# server adapter. These values are read by the local Node server (npm run dev /
# npm start). They are never sent to the browser.

# Which vendor the local adapter calls: anthropic | openai
LLM_VENDOR=anthropic

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Port for `npm start` (production server) and `npm run dev`
PORT=4173
DEV_PORT=5173
